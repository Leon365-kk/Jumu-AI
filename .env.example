# NVIDIA API Configuration
# NIM (NVIDIA Inference Microservices) — https://build.nvidia.com
# Get your key at https://build.nvidia.com/explore (sign in → Get API Key)
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Render API URL (for dual Vercel + Render deployments)
# When the frontend is deployed on Vercel and the API proxy on Render,
# set this to: https://<your-service>.onrender.com
VITE_API_URL=
