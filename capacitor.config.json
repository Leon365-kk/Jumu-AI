{
  "appId": "com.jumu.ai.app",
  "appName": "Jumu AI",
  "webDir": "frontend/dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "StatusBar": {
      "style": "dark"
    },
    "App": {
      "launchShowDuration": 0
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": "android/app/release.keystore"
    }
  }
}
